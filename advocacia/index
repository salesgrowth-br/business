  <div id="form-screen">
    <p class="page-title">Briefing de Onboarding</p>

    <form id="briefingForm" novalidate>

      <div class="section">
        <div class="section-head">
          <span class="section-num">01</span>
          <h2 class="section-title">Sobre o escritório</h2>
        </div>
        <p class="section-help">Pra gente saber quem é você e como te chamar.</p>

        <div class="field">
          <label class="flabel" for="nome_agencia">Nome do escritório<span class="req">*</span></label>
          <input type="text" id="nome_agencia" name="nome_agencia" required placeholder="Ex: Silva & Associados Advocacia">
        </div>
        <div class="field">
          <label class="flabel" for="responsavel">Seu nome<span class="req">*</span></label>
          <input type="text" id="responsavel" name="responsavel" required placeholder="Quem está respondendo">
        </div>
        <div class="field">
          <label class="flabel" for="whatsapp">WhatsApp para retorno<span class="req">*</span></label>
          <input type="tel" id="whatsapp" name="whatsapp" required placeholder="(11) 91234-5678">
        </div>
        <div class="field">
          <label class="flabel" for="instagram">Instagram<span class="opt">opcional</span></label>
          <input type="text" id="instagram" name="instagram" placeholder="@seuescritorio">
        </div>
        <div class="field">
          <label class="flabel" for="site">Site<span class="opt">opcional</span></label>
          <input type="url" id="site" name="site" placeholder="www.seuescritorio.com.br">
        </div>
      </div>

      <div class="section">
        <div class="section-head">
          <span class="section-num">02</span>
          <h2 class="section-title">Público-alvo</h2>
        </div>
        <p class="section-help">Quem você quer ver fechando contrato com você.</p>

        <div class="field">
          <label class="flabel" for="idade_publico">Faixa etária<span class="req">*</span></label>
          <input type="text" id="idade_publico" name="idade_publico" required placeholder="Ex: 30 a 55 anos">
        </div>
        <div class="field">
          <label class="flabel" for="regiao_publico">Região<span class="req">*</span></label>
          <input type="text" id="regiao_publico" name="regiao_publico" required placeholder="Ex: cidade, comarca, atuação regional ou nacional...">
        </div>
        <div class="field">
          <label class="flabel" for="renda_publico">Renda<span class="req">*</span></label>
          <input type="text" id="renda_publico" name="renda_publico" required placeholder="Ex: classe B/C, pessoa física ou jurídica...">
        </div>
        <div class="field">
          <label class="flabel" for="valoriza_publico">O que esse público mais valoriza num advogado?<span class="req">*</span></label>
          <textarea id="valoriza_publico" name="valoriza_publico" required placeholder="Confiança, transparência, agilidade, especialização, resultado..."></textarea>
        </div>
        <div class="field">
          <label class="flabel" for="destinos">Quais áreas do direito são o foco?<span class="req">*</span></label>
          <textarea id="destinos" name="destinos" required placeholder="Trabalhista, família, previdenciário, criminal, empresarial..."></textarea>
        </div>
        <div class="field">
          <label class="flabel">Vocês já têm esse público bem definido?<span class="req">*</span></label>
          <div class="chips">
            <input class="chip-input" type="radio" name="definicao_publico" id="dp1" value="Já sabemos bem" required>
            <label class="chip" for="dp1">Já sabemos bem</label>
            <input class="chip-input" type="radio" name="definicao_publico" id="dp2" value="Temos uma ideia">
            <label class="chip" for="dp2">Temos uma ideia</label>
            <input class="chip-input" type="radio" name="definicao_publico" id="dp3" value="Precisamos de ajuda">
            <label class="chip" for="dp3">Precisamos de ajuda</label>
          </div>
        </div>
      </div>

      <div class="section">
        <div class="section-head">
          <span class="section-num">03</span>
          <h2 class="section-title">Áreas de atuação e ticket</h2>
        </div>
        <p class="section-help">Quais áreas vocês atuam e quanto isso vale.</p>

        <div class="field">
          <label class="flabel">Quais áreas você quer anunciar?<span class="req">*</span></label>
          <div class="chips">
            <input class="chip-input" type="checkbox" name="tipo_produto" id="tp1" value="Direito de Família">
            <label class="chip" for="tp1">Direito de Família</label>
            <input class="chip-input" type="checkbox" name="tipo_produto" id="tp2" value="Trabalhista">
            <label class="chip" for="tp2">Trabalhista</label>
            <input class="chip-input" type="checkbox" name="tipo_produto" id="tp3" value="Previdenciário (INSS)">
            <label class="chip" for="tp3">Previdenciário (INSS)</label>
            <input class="chip-input" type="checkbox" name="tipo_produto" id="tp4" value="Criminal">
            <label class="chip" for="tp4">Criminal</label>
            <input class="chip-input" type="checkbox" name="tipo_produto" id="tp5" value="Empresarial">
            <label class="chip" for="tp5">Empresarial</label>
            <input class="chip-input" type="checkbox" name="tipo_produto" id="tp6" value="Tributário">
            <label class="chip" for="tp6">Tributário</label>
            <input class="chip-input" type="checkbox" name="tipo_produto" id="tp7" value="Consumidor">
            <label class="chip" for="tp7">Consumidor</label>
            <input class="chip-input" type="checkbox" name="tipo_produto" id="tp8" value="Outro">
            <label class="chip" for="tp8">Outro</label>
          </div>
        </div>
        <div class="field cond-field" id="cond-outro" hidden>
          <label class="flabel" for="outro_produto_desc">Qual?<span class="req">*</span></label>
          <textarea id="outro_produto_desc" name="outro_produto_desc" placeholder="Descreva"></textarea>
        </div>
        <div class="field">
          <label class="flabel" for="ticket_medio">Ticket médio por caso/contrato<span class="req">*</span></label>
          <div class="money"><input type="number" min="0" step="1" id="ticket_medio" name="ticket_medio" required placeholder="3000"></div>
        </div>
        <div class="field">
          <label class="flabel" for="comissao">Honorários líquidos médios por caso<span class="req">*</span></label>
          <input type="text" id="comissao" name="comissao" required placeholder="Ex: R$ 1.500 por caso, ou 30% de êxito">
          <div class="note">É esse número que a gente usa pra calcular o retorno de verdade da campanha, não só o que a plataforma mostra.</div>
        </div>
        <div class="field">
          <label class="flabel" for="sazonalidade">Tem época mais forte de procura?<span class="opt">opcional</span></label>
          <input type="text" id="sazonalidade" name="sazonalidade" placeholder="Ex: rescisões no início do ano, prazo de declaração de IR...">
        </div>
      </div>

      <div class="section">
        <div class="section-head">
          <span class="section-num">04</span>
          <h2 class="section-title">Investimento</h2>
        </div>
        <p class="section-help">Quanto dá pra investir por dia em anúncios.</p>

        <div class="field">
          <label class="flabel" for="investimento_slider">Investimento diário disponível<span class="req">*</span></label>
          <div class="slider-row">
            <input type="range" id="investimento_slider" min="25" max="1500" step="25" value="100">
            <div class="slider-readout"><span id="investimento_display">R$ 100</span><br><small>por dia</small></div>
          </div>
          <input type="hidden" id="investimento_diario" name="investimento_diario" value="100">
        </div>
        <div class="field">
          <label class="flabel">Já investe em anúncios hoje?<span class="req">*</span></label>
          <div class="chips">
            <input class="chip-input" type="radio" name="ja_investiu" id="ji1" value="Já invisto" required>
            <label class="chip" for="ji1">Já invisto</label>
            <input class="chip-input" type="radio" name="ja_investiu" id="ji2" value="Já investi antes">
            <label class="chip" for="ji2">Já investi antes</label>
            <input class="chip-input" type="radio" name="ja_investiu" id="ji3" value="Nunca investi">
            <label class="chip" for="ji3">Nunca investi</label>
          </div>
        </div>
        <div class="field">
          <label class="flabel">Plataformas de interesse<span class="opt">opcional</span></label>
          <div class="chips">
            <input class="chip-input" type="checkbox" name="plataformas" id="pl1" value="Meta Ads (Instagram/Facebook)">
            <label class="chip" for="pl1">Meta Ads</label>
            <input class="chip-input" type="checkbox" name="plataformas" id="pl2" value="Google Ads">
            <label class="chip" for="pl2">Google Ads</label>
            <input class="chip-input" type="checkbox" name="plataformas" id="pl3" value="As duas">
            <label class="chip" for="pl3">As duas</label>
            <input class="chip-input" type="checkbox" name="plataformas" id="pl4" value="Não sei, preciso de orientação">
            <label class="chip" for="pl4">Preciso de orientação</label>
          </div>
        </div>
      </div>

      <div class="section">
        <div class="section-head">
          <span class="section-num">05</span>
          <h2 class="section-title">Capacidade de atendimento</h2>
        </div>
        <p class="section-help">Pra gente gerar a quantidade certa de contato, sem sobrecarregar seu time.</p>

        <div class="field">
          <label class="flabel" for="leads_dia">Quantos novos contatos/casos por dia sua equipe atende bem, sem perder qualidade?<span class="req">*</span></label>
          <div class="stepper">
            <button type="button" id="leadsMinus" aria-label="Diminuir">–</button>
            <input type="number" min="1" step="1" id="leads_dia" name="leads_dia" required value="5" style="max-width:90px;text-align:center;">
            <button type="button" id="leadsPlus" aria-label="Aumentar">+</button>
          </div>
        </div>
        <div class="field">
          <label class="flabel" for="pessoas_atendimento">Quantas pessoas fazem esse atendimento hoje?<span class="req">*</span></label>
          <input type="number" min="1" step="1" id="pessoas_atendimento" name="pessoas_atendimento" required placeholder="1">
        </div>
        <div class="field">
          <label class="flabel" for="horario">Horário de atendimento<span class="req">*</span></label>
          <input type="text" id="horario" name="horario" required placeholder="Ex: 9h às 18h, seg a sáb">
        </div>
        <div class="field">
          <label class="flabel">Canal principal de atendimento<span class="req">*</span></label>
          <div class="chips">
            <input class="chip-input" type="radio" name="canal" id="cn1" value="WhatsApp" required>
            <label class="chip" for="cn1">WhatsApp</label>
            <input class="chip-input" type="radio" name="canal" id="cn2" value="Instagram Direct">
            <label class="chip" for="cn2">Instagram Direct</label>
            <input class="chip-input" type="radio" name="canal" id="cn3" value="Telefone">
            <label class="chip" for="cn3">Telefone</label>
            <input class="chip-input" type="radio" name="canal" id="cn4" value="Outro">
            <label class="chip" for="cn4">Outro</label>
          </div>
        </div>
      </div>

      <div class="section">
        <div class="section-head">
          <span class="section-num">06</span>
          <h2 class="section-title">Procedimentos e diferenciais</h2>
        </div>
        <p class="section-help">Como funciona por dentro, hoje.</p>

        <div class="field">
          <label class="flabel" for="fluxo">Como é o atendimento do primeiro contato até o fechamento do contrato?<span class="req">*</span></label>
          <textarea id="fluxo" name="fluxo" required placeholder="Descreve o passo a passo, resumido"></textarea>
        </div>
        <div class="field">
          <label class="flabel" for="diferenciais">O que diferencia vocês da concorrência?<span class="req">*</span></label>
          <textarea id="diferenciais" name="diferenciais" required placeholder="Atendimento, especialização, resultados, transparência, parcelamento..."></textarea>
        </div>
        <div class="field">
          <label class="flabel" for="objecoes">Quais as dúvidas ou objeções mais comuns dos clientes?<span class="opt">opcional</span></label>
          <textarea id="objecoes" name="objecoes" placeholder="Ex: honorários, prazo do processo, desconfiança, parcelamento..."></textarea>
        </div>
      </div>

      <div class="section">
        <div class="section-head">
          <span class="section-num">07</span>
          <h2 class="section-title">Objetivo</h2>
        </div>
        <p class="section-help">Pra alinhar o foco da campanha.</p>

        <div class="field">
          <label class="flabel">Qual o principal objetivo agora?<span class="req">*</span></label>
          <div class="chips">
            <input class="chip-input" type="radio" name="objetivo" id="ob1" value="Gerar mais consultas" required>
            <label class="chip" for="ob1">Gerar mais consultas</label>
            <input class="chip-input" type="radio" name="objetivo" id="ob2" value="Aumentar clientes">
            <label class="chip" for="ob2">Aumentar clientes</label>
            <input class="chip-input" type="radio" name="objetivo" id="ob3" value="Os dois">
            <label class="chip" for="ob3">Os dois</label>
            <input class="chip-input" type="radio" name="objetivo" id="ob4" value="Fortalecer a marca">
            <label class="chip" for="ob4">Fortalecer a marca</label>
          </div>
        </div>
        <div class="field">
          <label class="flabel" for="observacoes">Alguma observação extra?<span class="opt">opcional</span></label>
          <textarea id="observacoes" name="observacoes" placeholder="Fica à vontade"></textarea>
        </div>
      </div>

      <button type="submit" class="cta">Revisar e enviar →</button>
    </form>

    <div class="foot">
      <span class="fw">Sales Growth</span> · tráfego pago para escritórios de advocacia<br>
      @salesgrowth.br
    </div>
  </div>

  <div id="review">
    <p class="eyebrow">Quase lá</p>
    <h1>Confere se ficou tudo certo</h1>
    <p class="lede">Se quiser ajustar algo, é só voltar e editar. Depois é só mandar no WhatsApp.</p>

    <div class="rev-card" id="revContent"></div>

    <a href="#" target="_blank" rel="noopener" class="send-wa" id="sendWaBtn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17.6 6.32A7.85 7.85 0 0 0 12.05 4a7.94 7.94 0 0 0-6.9 11.9L4 20l4.2-1.1a7.9 7.9 0 0 0 3.85 1h.01A7.95 7.95 0 0 0 20 12a7.9 7.9 0 0 0-2.4-5.68Zm-5.55 12.2a6.6 6.6 0 0 1-3.36-.92l-.24-.14-2.5.65.67-2.43-.16-.25a6.6 6.6 0 1 1 12.24-3.5 6.6 6.6 0 0 1-6.65 6.6Zm3.62-4.94c-.2-.1-1.17-.58-1.35-.64-.18-.07-.31-.1-.44.1-.13.19-.5.64-.62.78-.11.13-.23.15-.42.05-.2-.1-.83-.3-1.58-.97-.58-.52-.98-1.16-1.09-1.36-.11-.19-.01-.3.09-.4.09-.09.2-.23.3-.35.1-.11.13-.19.2-.32.06-.13.03-.24-.02-.34-.05-.1-.44-1.06-.6-1.45-.16-.38-.32-.33-.44-.33-.11 0-.24-.02-.37-.02-.13 0-.34.05-.52.24-.18.19-.68.66-.68 1.62 0 .95.7 1.87.79 2 .1.13 1.37 2.1 3.33 2.94.46.2.83.32 1.11.41.47.15.9.13 1.24.08.38-.06 1.17-.48 1.33-.94.17-.46.17-.86.12-.94-.05-.09-.18-.14-.38-.24Z" fill="currentColor"/></svg>
      Enviar no WhatsApp
    </a>
    <button type="button" class="copy-btn" id="copyBtn">Copiar mensagem</button>
    <a class="back-link" id="backLink">← Editar respostas</a>

    <div class="foot">
      <span class="fw">Sales Growth</span> · tráfego pago para escritórios de advocacia
    </div>
  </div>

</div>

<script>
(function(){

  // ====== CONFIGURAÇÃO — troque pelo número real antes de enviar o link ======
  // Formato: DDI + DDD + número, só dígitos. Ex: Brasil (11) 91234-5678 -> "5511912345678"
  var AGENCY_WHATSAPP = "5579998157108";

  var form = document.getElementById('briefingForm');
  var formScreen = document.getElementById('form-screen');
  var review = document.getElementById('review');

  // slider <-> hidden field sync
  var slider = document.getElementById('investimento_slider');
  var sliderDisplay = document.getElementById('investimento_display');
  var sliderHidden = document.getElementById('investimento_diario');
  function fmtMoney(v){ return 'R$ ' + Number(v).toLocaleString('pt-BR'); }
  slider.addEventListener('input', function(){
    sliderDisplay.textContent = fmtMoney(slider.value);
    sliderHidden.value = slider.value;
    updateProgress();
  });

  // leads stepper
  var leadsInput = document.getElementById('leads_dia');
  document.getElementById('leadsMinus').addEventListener('click', function(){
    leadsInput.value = Math.max(1, (parseInt(leadsInput.value||'1',10) - 1));
    updateProgress();
  });
  document.getElementById('leadsPlus').addEventListener('click', function(){
    leadsInput.value = (parseInt(leadsInput.value||'0',10) + 1);
    updateProgress();
  });

  // progress bar based on required fields filled
  var progressFill = document.getElementById('progressFill');
  function updateProgress(){
    var required = form.querySelectorAll('[required]');
    var groups = {};
    var total = 0, filled = 0;
    required.forEach(function(el){
      if(el.type === 'radio'){
        groups[el.name] = groups[el.name] || {els:[]};
        groups[el.name].els.push(el);
      } else {
        total++;
        if(el.value && el.value.trim() !== '') filled++;
      }
    });
    Object.keys(groups).forEach(function(name){
      total++;
      if(groups[name].els.some(function(el){ return el.checked; })) filled++;
    });
    var pct = total ? Math.round((filled/total)*100) : 0;
    progressFill.style.width = pct + '%';
  }
  form.addEventListener('input', updateProgress);
  form.addEventListener('change', updateProgress);
  updateProgress();

  // "o que quer anunciar": campos condicionais + validação de "pelo menos um"
  function bindConditional(checkboxId, fieldId, inputId){
    var cb = document.getElementById(checkboxId);
    var field = document.getElementById(fieldId);
    var input = document.getElementById(inputId);
    if(!cb || !field || !input) return;
    function sync(){
      if(cb.checked){
        field.hidden = false;
        input.required = true;
      } else {
        field.hidden = true;
        input.required = false;
        input.value = '';
      }
      updateProgress();
    }
    cb.addEventListener('change', sync);
    sync();
  }

  var tipoProdutoBoxes = form.querySelectorAll('input[name="tipo_produto"]');
  function validateTipoProduto(){
    var anyChecked = Array.prototype.slice.call(tipoProdutoBoxes).some(function(cb){ return cb.checked; });
    if(tipoProdutoBoxes[0]) tipoProdutoBoxes[0].setCustomValidity(anyChecked ? '' : 'Escolha pelo menos uma opção');
  }
  form.addEventListener('change', validateTipoProduto);
  validateTipoProduto();
  bindConditional('tp8', 'cond-outro', 'outro_produto_desc');

  function esc(s){
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function getData(){
    var fd = new FormData(form);
    var data = {};
    fd.forEach(function(value, key){
      if(data[key] !== undefined){
        data[key] = Array.isArray(data[key]) ? data[key].concat(value) : [data[key], value];
      } else {
        data[key] = value;
      }
    });
    var plataformas = fd.getAll('plataformas');
    data.plataformas = plataformas.length ? plataformas.join(', ') : 'Não informado';
    var tipoProduto = fd.getAll('tipo_produto');
    data.tipo_produto = tipoProduto.length ? tipoProduto.join(', ') : 'Não informado';
    return data;
  }

  function buildWaMessage(d){
    var lines = [];
    lines.push('📋 *BRIEFING DE ONBOARDING — SALES GROWTH*');
    lines.push('');
    lines.push('*Escritório:* ' + d.nome_agencia);
    lines.push('*Responsável:* ' + d.responsavel);
    lines.push('*WhatsApp:* ' + d.whatsapp);
    if(d.instagram) lines.push('*Instagram:* ' + d.instagram);
    if(d.site) lines.push('*Site:* ' + d.site);
    lines.push('');
    lines.push('*— PÚBLICO-ALVO —*');
    lines.push('Faixa etária: ' + d.idade_publico);
    lines.push('Região: ' + d.regiao_publico);
    lines.push('Renda: ' + d.renda_publico);
    lines.push('O que valoriza: ' + d.valoriza_publico);
    lines.push('Áreas de atuação: ' + d.destinos);
    lines.push('Definição do público: ' + d.definicao_publico);
    lines.push('');
    lines.push('*— ÁREAS DE ATUAÇÃO E TICKET —*');
    lines.push('O que quer anunciar: ' + d.tipo_produto);
    if(d.outro_produto_desc) lines.push('Outro (detalhe): ' + d.outro_produto_desc);
    lines.push('Ticket médio: R$ ' + d.ticket_medio);
    lines.push('Honorários líquidos médios: ' + d.comissao);
    if(d.sazonalidade) lines.push('Sazonalidade: ' + d.sazonalidade);
    lines.push('');
    lines.push('*— INVESTIMENTO —*');
    lines.push('Investimento diário: R$ ' + d.investimento_diario);
    lines.push('Já investe em anúncios: ' + d.ja_investiu);
    lines.push('Plataformas: ' + d.plataformas);
    lines.push('');
    lines.push('*— CAPACIDADE DE ATENDIMENTO —*');
    lines.push('Novos contatos/dia: ' + d.leads_dia);
    lines.push('Pessoas no atendimento: ' + d.pessoas_atendimento);
    lines.push('Horário: ' + d.horario);
    lines.push('Canal principal: ' + d.canal);
    lines.push('');
    lines.push('*— PROCEDIMENTOS —*');
    lines.push('Fluxo até o fechamento: ' + d.fluxo);
    lines.push('Diferenciais: ' + d.diferenciais);
    if(d.objecoes) lines.push('Objeções comuns: ' + d.objecoes);
    lines.push('');
    lines.push('*— OBJETIVO —*');
    lines.push('Objetivo principal: ' + d.objetivo);
    if(d.observacoes) lines.push('Observações: ' + d.observacoes);
    lines.push('');
    lines.push('_Enviado pelo Briefing Sales Growth_ 🚀');
    return lines.join('\n');
  }

  function renderReview(d){
    var groups = [
      {title:'Sobre o escritório', rows:[
        ['Escritório', d.nome_agencia],['Responsável', d.responsavel],['WhatsApp', d.whatsapp],
        ['Instagram', d.instagram || '—'],['Site', d.site || '—']
      ]},
      {title:'Público-alvo', rows:[
        ['Faixa etária', d.idade_publico],['Região', d.regiao_publico],['Renda', d.renda_publico],['O que valoriza', d.valoriza_publico],['Áreas de atuação', d.destinos],['Definição', d.definicao_publico]
      ]},
      {title:'Áreas de atuação e ticket', rows:[
        ['O que anuncia', d.tipo_produto],['Outro (detalhe)', d.outro_produto_desc || '—'],['Ticket médio', 'R$ ' + d.ticket_medio],['Honorários líquidos', d.comissao],['Sazonalidade', d.sazonalidade || '—']
      ]},
      {title:'Investimento', rows:[
        ['Investimento diário', 'R$ ' + d.investimento_diario],['Já investe', d.ja_investiu],['Plataformas', d.plataformas]
      ]},
      {title:'Capacidade de atendimento', rows:[
        ['Novos contatos/dia', d.leads_dia],['Pessoas no atendimento', d.pessoas_atendimento],['Horário', d.horario],['Canal', d.canal]
      ]},
      {title:'Procedimentos', rows:[
        ['Fluxo até o fechamento', d.fluxo],['Diferenciais', d.diferenciais],['Objeções', d.objecoes || '—']
      ]},
      {title:'Objetivo', rows:[
        ['Objetivo principal', d.objetivo],['Observações', d.observacoes || '—']
      ]}
    ];
    var html = '';
    groups.forEach(function(g){
      html += '<div class="rev-group"><h3>' + esc(g.title) + '</h3>';
      g.rows.forEach(function(r){
        html += '<div class="rev-row"><span class="rev-k">' + esc(r[0]) + '</span><span class="rev-v">' + esc(String(r[1])) + '</span></div>';
      });
      html += '</div>';
    });
    document.getElementById('revContent').innerHTML = html;
  }

  var lastMessage = '';

  form.addEventListener('submit', function(e){
    e.preventDefault();
    if(!form.reportValidity()) return;
    var data = getData();
    renderReview(data);
    lastMessage = buildWaMessage(data);
    var url = 'https://wa.me/' + AGENCY_WHATSAPP + '?text=' + encodeURIComponent(lastMessage);
    document.getElementById('sendWaBtn').setAttribute('href', url);
    formScreen.classList.add('hide');
    review.classList.add('show');
    window.scrollTo({top:0, behavior:'smooth'});
  });

  document.getElementById('backLink').addEventListener('click', function(){
    review.classList.remove('show');
    formScreen.classList.remove('hide');
    window.scrollTo({top:0, behavior:'smooth'});
  });

  document.getElementById('copyBtn').addEventListener('click', function(){
    var btn = this;
    var done = function(){
      var original = 'Copiar mensagem';
      btn.textContent = 'Copiado ✓';
      setTimeout(function(){ btn.textContent = original; }, 1800);
    };
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(lastMessage).then(done).catch(function(){
        fallbackCopy(lastMessage); done();
      });
    } else {
      fallbackCopy(lastMessage); done();
    }
  });

  function fallbackCopy(text){
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try{ document.execCommand('copy'); }catch(e){}
    document.body.removeChild(ta);
  }

})();
</script>
</body>
</html>
