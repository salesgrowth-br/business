<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#060810">
<meta name="color-scheme" content="dark">
<title>Sales Growth | Briefing de Onboarding</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
<link rel="icon" type="image/png" sizes="64x64" href="data:image/png;base64,">
<link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,">
<style>

@font-face {
  font-family: 'Sora';
  src: url(data:font/woff2;base64,) format('woff2');
  font-weight: 100 800;
  font-display: swap;
}
@font-face {
  font-family: 'Inclusive Sans';
  src: url(data:font/woff2;base64,) format('woff2');
  font-weight: 300 700;
  font-display: swap;
}

:root{
  --bg:#060810;
  --card:rgba(255,255,255,.035);
  --card-hover:rgba(255,255,255,.05);
  --border:rgba(255,255,255,.09);
  --border-focus:rgba(0,21,255,.55);
  --text:#F3F4FA;
  --dim:#98A0BE;
  --faint:#5A6082;
  --blue-1:#0011CE;
  --blue-2:#0015FF;
  --amber:#FFB238;
  --wa:#25D366;
  --wa-hi:#3EE87F;
  --radius:18px;
  --font-d:'Sora',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --font-b:'Inclusive Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
}

*{box-sizing:border-box;}
html{-webkit-text-size-adjust:100%;}
body{
  margin:0;
  min-height:100vh;
  background:var(--bg);
  color:var(--text);
  font-family:var(--font-b);
  font-size:16px;
  line-height:1.5;
  position:relative;
  overflow-x:hidden;
}

body::before{
  content:'';
  position:fixed;
  inset:0;
  background:
    radial-gradient(ellipse 900px 600px at 88% -8%, rgba(0,21,255,.28), transparent 60%),
    radial-gradient(ellipse 700px 500px at -10% 15%, rgba(0,17,206,.16), transparent 55%),
    radial-gradient(ellipse 900px 700px at 50% 115%, rgba(0,21,255,.10), transparent 60%);
  pointer-events:none;
  z-index:0;
}
body::after{
  content:'';
  position:fixed;
  inset:0;
  opacity:.035;
  mix-blend-mode:overlay;
  pointer-events:none;
  z-index:0;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
}

.bg-tri{
  position:fixed;
  pointer-events:none;
  z-index:0;
  opacity:.05;
}
.bg-tri--1{ top:-60px; right:-90px; width:380px; height:380px; transform:rotate(12deg); }
.bg-tri--2{ bottom:-120px; left:-110px; width:420px; height:420px; transform:rotate(-18deg); }

.wrap{
  position:relative;
  z-index:1;
  max-width:640px;
  margin:0 auto;
  padding:28px 20px 60px;
}

.progress-rail{
  position:fixed;
  top:0; left:0; right:0;
  height:3px;
  background:rgba(255,255,255,.06);
  z-index:10;
}
.progress-fill{
  height:100%;
  width:0%;
  background:linear-gradient(90deg,var(--blue-1),var(--blue-2));
  transition:width .35s ease;
}

header.top{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:34px;
  animation:rise .6s ease both;
}
.logo-mark{ flex:none; }
.wordmark{
  font-family:var(--font-d);
  font-weight:700;
  font-size:17px;
  letter-spacing:.01em;
}
.wordmark span{
  background:linear-gradient(90deg,#5B6BFF,#8CA0FF);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.eyebrow{
  font-family:var(--font-d);
  font-size:11px;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--amber);
  margin:0 0 14px;
  animation:rise .6s ease .05s both;
}
h1{
  font-family:var(--font-d);
  font-size:clamp(26px,6vw,34px);
  font-weight:700;
  line-height:1.15;
  margin:0 0 12px;
  letter-spacing:-.01em;
  animation:rise .6s ease .1s both;
}
.lede{
  color:var(--dim);
  font-size:15.5px;
  line-height:1.6;
  margin:0 0 8px;
  max-width:52ch;
  animation:rise .6s ease .15s both;
}
.page-title{
  font-family:var(--font-d);
  font-weight:600;
  font-size:21px;
  color:var(--text);
  letter-spacing:-.005em;
  margin:0 0 32px;
  animation:rise .6s ease .1s both;
}

@keyframes rise{
  from{ opacity:0; transform:translateY(14px); }
  to{ opacity:1; transform:translateY(0); }
}

form{ margin-top:30px; }

.section{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:26px 22px;
  margin-bottom:16px;
  animation:rise .6s ease both;
  transition:border-color .25s ease;
}
.section:nth-of-type(1){animation-delay:.18s;}
.section:nth-of-type(2){animation-delay:.22s;}
.section:nth-of-type(3){animation-delay:.26s;}
.section:nth-of-type(4){animation-delay:.30s;}
.section:nth-of-type(5){animation-delay:.34s;}
.section:nth-of-type(6){animation-delay:.38s;}
.section:nth-of-type(7){animation-delay:.42s;}

.section-head{
  display:flex;
  align-items:baseline;
  gap:14px;
  margin-bottom:6px;
}
.section-num{
  font-family:var(--font-d);
  font-weight:700;
  font-size:22px;
  background:linear-gradient(160deg,#5B6BFF,#8CA0FF);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  flex:none;
}
.section-title{
  font-family:var(--font-d);
  font-weight:600;
  font-size:18px;
  margin:0;
}
.section-help{
  color:var(--faint);
  font-size:13.5px;
  margin:2px 0 20px 36px;
}

.field{ margin-bottom:18px; }
.field:last-child{ margin-bottom:0; }
label.flabel{
  display:block;
  font-size:13.5px;
  font-weight:600;
  color:var(--text);
  margin-bottom:8px;
}
.req{ color:var(--amber); margin-left:3px; }
.opt{ color:var(--faint); font-weight:400; font-size:12px; margin-left:6px; }

input[type=text],
input[type=tel],
input[type=url],
input[type=number],
textarea{
  width:100%;
  background:rgba(255,255,255,.03);
  border:1px solid var(--border);
  border-radius:11px;
  padding:13px 14px;
  color:var(--text);
  font-family:var(--font-b);
  font-size:15px;
  outline:none;
  transition:border-color .2s ease, background .2s ease;
  -webkit-appearance:none;
  appearance:none;
}
input::placeholder, textarea::placeholder{ color:var(--faint); }
input:focus, textarea:focus{
  border-color:var(--border-focus);
  background:rgba(255,255,255,.045);
}
textarea{ min-height:78px; resize:vertical; line-height:1.5; }

input[type=number]::-webkit-inner-spin-button,
input[type=number]::-webkit-outer-spin-button{ -webkit-appearance:none; margin:0; }
input[type=number]{ -moz-appearance:textfield; }

.money{
  position:relative;
}
.money input{ padding-left:34px; }
.money::before{
  content:'R$';
  position:absolute;
  left:14px; top:50%;
  transform:translateY(-50%);
  color:var(--faint);
  font-size:14px;
  pointer-events:none;
}

.slider-row{ display:flex; align-items:center; gap:14px; }
input[type=range]{
  flex:1;
  -webkit-appearance:none;
  appearance:none;
  height:5px;
  border-radius:99px;
  background:linear-gradient(90deg,var(--blue-1),var(--blue-2));
  outline:none;
}
input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;
  width:20px;height:20px;border-radius:50%;
  background:#fff;
  box-shadow:0 0 0 4px rgba(0,21,255,.35), 0 2px 6px rgba(0,0,0,.4);
  cursor:pointer;
}
input[type=range]::-moz-range-thumb{
  width:20px;height:20px;border-radius:50%;border:none;
  background:#fff;
  box-shadow:0 0 0 4px rgba(0,21,255,.35), 0 2px 6px rgba(0,0,0,.4);
  cursor:pointer;
}
.slider-readout{
  flex:none;
  min-width:92px;
  text-align:right;
  font-family:var(--font-d);
  font-weight:600;
  font-size:15px;
}
.slider-readout small{ color:var(--faint); font-weight:400; font-size:12px; }

.stepper{ display:flex; align-items:center; gap:12px; }
.stepper button{
  width:40px;height:40px;flex:none;
  border-radius:10px;
  border:1px solid var(--border);
  background:rgba(255,255,255,.03);
  color:var(--text);
  font-size:18px;
  font-family:var(--font-d);
  cursor:pointer;
  transition:border-color .2s, background .2s;
}
.stepper button:hover{ border-color:var(--border-focus); background:rgba(255,255,255,.06); }
.stepper input{ text-align:center; }

.chips{ display:flex; flex-wrap:wrap; gap:9px; }
.chip-input{ position:absolute; opacity:0; width:1px; height:1px; }
.chip{
  display:inline-flex;
  align-items:center;
  padding:10px 16px;
  border:1px solid var(--border);
  border-radius:99px;
  font-size:13.5px;
  color:var(--dim);
  cursor:pointer;
  transition:all .18s ease;
  user-select:none;
}
.chip:hover{ border-color:rgba(255,255,255,.22); color:var(--text); }
.chip-input:checked + .chip{
  background:linear-gradient(90deg,var(--blue-1),var(--blue-2));
  border-color:transparent;
  color:#fff;
  box-shadow:0 4px 14px rgba(0,21,255,.3);
}
.chip-input:focus-visible + .chip{ outline:2px solid var(--border-focus); outline-offset:2px; }

.note{
  display:flex;
  gap:8px;
  align-items:flex-start;
  margin-top:10px;
  padding:11px 13px;
  border-radius:10px;
  background:rgba(255,178,56,.07);
  border:1px solid rgba(255,178,56,.18);
  font-size:12.5px;
  color:#E8C48A;
  line-height:1.5;
}

.cta{
  width:100%;
  margin-top:22px;
  padding:15px 20px;
  border-radius:13px;
  border:1px solid rgba(0,21,255,.42);
  background:rgba(0,21,255,.08);
  color:#fff;
  font-family:var(--font-d);
  font-weight:600;
  font-size:15px;
  cursor:pointer;
  transition:border-color .2s ease, background .2s ease, transform .15s ease;
}
.cta:hover{ background:rgba(0,21,255,.14); border-color:rgba(0,21,255,.65); transform:translateY(-1px); }
.cta:active{ transform:translateY(0); }

.foot{
  text-align:center;
  margin-top:38px;
  color:var(--faint);
  font-size:12px;
  line-height:1.8;
}
.foot .fw{ color:var(--dim); font-family:var(--font-d); font-weight:600; }

/* ---- review screen ---- */
#review{ display:none; }
#review.show{ display:block; animation:rise .5s ease both; }
#form-screen.hide{ display:none; }

.rev-card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:24px 22px;
  margin-bottom:16px;
}
.rev-group{ margin-bottom:20px; }
.rev-group:last-child{ margin-bottom:0; }
.rev-group h3{
  font-family:var(--font-d);
  font-size:12px;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--amber);
  margin:0 0 10px;
}
.rev-row{
  display:flex;
  justify-content:space-between;
  gap:16px;
  padding:9px 0;
  border-bottom:1px solid rgba(255,255,255,.06);
  font-size:14px;
}
.rev-row:last-child{ border-bottom:none; }
.rev-k{ color:var(--faint); flex:none; width:42%; }
.rev-v{ color:var(--text); text-align:right; flex:1; }

.send-wa{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:9px;
  width:100%;
  margin-top:6px;
  padding:14px 20px;
  border-radius:13px;
  background:rgba(37,211,102,.07);
  border:1px solid rgba(37,211,102,.32);
  color:var(--wa-hi);
  font-family:var(--font-d);
  font-weight:600;
  font-size:14.5px;
  text-decoration:none;
  transition:border-color .2s ease, background .2s ease, transform .15s ease;
}
.send-wa:hover{ background:rgba(37,211,102,.12); border-color:rgba(37,211,102,.5); transform:translateY(-1px); }

.copy-btn{
  width:100%;
  margin-top:10px;
  padding:14px 20px;
  border-radius:14px;
  border:1px solid var(--border);
  background:transparent;
  color:var(--dim);
  font-family:var(--font-b);
  font-weight:600;
  font-size:14px;
  cursor:pointer;
  transition:border-color .2s, color .2s;
}
.copy-btn:hover{ border-color:rgba(255,255,255,.25); color:var(--text); }

.back-link{
  display:block;
  text-align:center;
  margin-top:18px;
  color:var(--faint);
  font-size:13.5px;
  text-decoration:none;
  cursor:pointer;
}
.back-link:hover{ color:var(--dim); }

@media (max-width:420px){
  .wrap{ padding:22px 16px 50px; }
  .section{ padding:22px 16px; }
  .rev-row{ font-size:13px; }
}
</style>
</head>
